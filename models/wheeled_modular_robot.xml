<mujoco model="ModuBalance slow wheeled prototype">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>
  <default><geom friction="0.8 0.01 0.001"/><joint damping="0.4" armature="0.02"/></default>
  <worldbody>
    <light pos="0 -2 3" dir="0 0 -1" directional="true"/>
    <geom name="ground" type="plane" size="5 5 0.1" rgba="0.2 0.22 0.24 1"/>
    <body name="wheel_base" pos="0 0 0.11">
      <joint name="wheel_base_slide" type="slide" axis="1 0 0" range="-2 2" damping="15"/>
      <geom type="box" size="0.30 0.20 0.05" mass="8" rgba="0.20 0.25 0.32 1"/>
      <geom type="cylinder" pos="0 0.22 -0.03" euler="90 0 0" size="0.08 0.035" mass="0.5" rgba="0.08 0.08 0.08 1"/>
      <geom type="cylinder" pos="0 -0.22 -0.03" euler="90 0 0" size="0.08 0.035" mass="0.5" rgba="0.08 0.08 0.08 1"/>
      <body name="wheeled_body" pos="0 0 0.05">
        <joint name="wheeled_pitch" type="hinge" axis="0 1 0" range="-25 25"/>
        <geom name="wheeled_body_geom" type="box" pos="0 0 0.18" size="0.16 0.14 0.18" mass="4" rgba="0.25 0.55 0.82 1"/>
        <site name="wheeled_imu" pos="0 0 0.18"/>
        <site name="wheeled_payload_site" pos="0.07 0 0.38"/>
        <geom name="wheeled_payload" type="box" pos="0.07 0 0.415" size="0.06 0.06 0.035" mass="0" contype="0" conaffinity="0" rgba="0.8 0.2 0.2 0.7"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="wheeled_pitch_motor" joint="wheeled_pitch" ctrllimited="true" ctrlrange="-20 20"/>
    <position name="wheel_base_servo" joint="wheel_base_slide" kp="700" kv="120" ctrllimited="true" ctrlrange="-2 2"/>
  </actuator>
  <sensor>
    <framequat name="wheeled_orientation" objtype="site" objname="wheeled_imu"/>
    <gyro name="wheeled_gyro" site="wheeled_imu"/>
    <jointpos name="wheeled_base_position" joint="wheel_base_slide"/>
    <jointvel name="wheeled_base_velocity" joint="wheel_base_slide"/>
    <actuatorfrc name="wheeled_torque" actuator="wheeled_pitch_motor"/>
  </sensor>
</mujoco>

