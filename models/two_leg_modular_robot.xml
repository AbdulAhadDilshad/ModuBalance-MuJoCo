<mujoco model="ModuBalance standing two-leg prototype">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>
  <default><geom friction="1.0 0.01 0.001"/><joint damping="0.5" armature="0.02"/></default>
  <worldbody>
    <light pos="0 -2 3" dir="0 0 -1" directional="true"/>
    <geom name="ground" type="plane" size="4 4 0.1" rgba="0.2 0.22 0.24 1"/>
    <!-- Standing-balance feasibility rig: co-located roll/pitch pivots at pelvis height. -->
    <body name="stand_roll_frame" pos="0 0 0.62">
      <inertial pos="0 0 0" mass="0.01" diaginertia="0.0001 0.0001 0.0001"/>
      <joint name="stand_roll" type="hinge" axis="1 0 0" range="-20 20"/>
      <body name="robot_body">
        <joint name="stand_pitch" type="hinge" axis="0 1 0" range="-20 20"/>
        <geom name="body_geom" type="box" pos="0 0 0.10" size="0.24 0.14 0.10" mass="5" rgba="0.25 0.55 0.82 1"/>
        <site name="body_imu" pos="0 0 0.10"/>
        <site name="prototype_payload_site" pos="0.08 0 0.22"/>
        <geom name="prototype_payload" type="box" pos="0.08 0 0.255" size="0.07 0.07 0.035" mass="0" contype="0" conaffinity="0" rgba="0.8 0.2 0.2 0.7"/>
        <body name="left_upper_leg" pos="0 0.15 -0.14">
          <geom type="box" pos="0 0 -0.13" size="0.07 0.07 0.13" mass="1.2" rgba="0.9 0.48 0.16 1"/>
          <body name="left_lower_leg" pos="0 0 -0.26">
            <geom type="box" pos="0 0 0" size="0.065 0.065 0.13" mass="1.0" rgba="0.36 0.68 0.34 1"/>
            <geom name="left_foot" type="box" pos="0.06 0 -0.17" size="0.14 0.09 0.05" mass="0.8" rgba="0.18 0.18 0.20 1"/>
          </body>
        </body>
        <body name="right_upper_leg" pos="0 -0.15 -0.14">
          <geom type="box" pos="0 0 -0.13" size="0.07 0.07 0.13" mass="1.2" rgba="0.9 0.48 0.16 1"/>
          <body name="right_lower_leg" pos="0 0 -0.26">
            <geom type="box" pos="0 0 0" size="0.065 0.065 0.13" mass="1.0" rgba="0.36 0.68 0.34 1"/>
            <geom name="right_foot" type="box" pos="0.06 0 -0.17" size="0.14 0.09 0.05" mass="0.8" rgba="0.18 0.18 0.20 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="stand_pitch_motor" joint="stand_pitch" ctrllimited="true" ctrlrange="-30 30"/>
    <motor name="stand_roll_motor" joint="stand_roll" ctrllimited="true" ctrlrange="-30 30"/>
  </actuator>
  <sensor>
    <framequat name="prototype_orientation" objtype="site" objname="body_imu"/>
    <gyro name="prototype_gyro" site="body_imu"/>
    <actuatorfrc name="prototype_pitch_torque" actuator="stand_pitch_motor"/>
    <actuatorfrc name="prototype_roll_torque" actuator="stand_roll_motor"/>
  </sensor>
</mujoco>
